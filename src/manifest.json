{
  "author": "Timofei Marenko",

  "content_scripts": [
    {
      "css": [
        "css/chat.css",
        "css/video-player.css"
      ],
      "js": [
        "scripts/libs/hls.min.js",
        "scripts/libs/jquery.min.js",
        "scripts/libs/reconnecting-websocket.min.js",
        "scripts/proxy-chat.js",
        "scripts/proxy-stream.js",
        "scripts/utils.js",
        "scripts/content.js"
      ],
      "matches": [
        "*://*.twitch.tv/*"
      ],
      "all_frames": true,
      "run_at": "document_end"
    }
  ],
  "background": {
    "scripts": ["scripts/background.js"]
  },
  "permissions": [
    "storage",
    "*://*.amazonaws.com/*",
    "*://*.betterttv.net/*",
    "*://*.7tv.io/*",
    "*://*.twitch.tv/*",
    "*://*.ttvnw.net/*",
    "*://kick.com/*",
    "*://*.kick.com/*",
    "*://*.pusher.com/*"
  ],
  "web_accessible_resources": ["config.json"],
  "description": "Automatically opens a proxy stream & chat if you are banned in a channel.",
  "icons": {
    "128": "images/icon128.png",
    "16": "images/icon16.png",
    "48": "images/icon48.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "twitchantiban@timofey",
      "strict_min_version": "101.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "manifest_version": 2,
  "name": "Twitch Anti-Ban",
  "version": "4.3"
}
